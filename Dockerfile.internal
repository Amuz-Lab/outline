# Keep the release runtime and fork's editor schema aligned.
FROM docker.getoutline.com/outlinewiki/outline:1.11.0 AS builder
USER root
WORKDIR /src
COPY . .
ENV NODE_ENV=production CI=1 URL=https://outline.example.invalid
RUN node -e "if (require('./package.json').version !== '1.11.0') throw new Error('Runtime image must match source release')" \
 && npm exec --yes --package=@yarnpkg/cli-dist@4.18.0 -- yarn install --immutable \
 && npm exec --yes --package=@yarnpkg/cli-dist@4.18.0 -- yarn build:server \
 && npm exec --yes --package=@yarnpkg/cli-dist@4.18.0 -- yarn vite:build

FROM docker.getoutline.com/outlinewiki/outline:1.11.0
ARG SOURCE_REVISION
LABEL org.opencontainers.image.source="https://github.com/Amuz-Lab/outline" \
 org.opencontainers.image.revision="${SOURCE_REVISION}"
COPY --from=builder --chown=nodejs:nodejs /src/build/ /opt/outline/build/
# fflate is the only additional runtime dependency of the shared ZIP importer.
COPY --from=builder --chown=nodejs:nodejs /src/node_modules/fflate/ /opt/outline/node_modules/fflate/
